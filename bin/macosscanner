#!/bin/bash
# macosscanner — find where your macOS disk space went.
#
# This launcher only does preflight. All logic lives in the Python package,
# which sits one directory up (the launcher cannot live beside it: the
# package directory is itself named storagescan).

set -euo pipefail

# Resolve symlinks before locating the package. install.sh puts a symlink on
# PATH, and BASH_SOURCE then points at the *link*, not at this file — so a
# naive dirname resolves to ~/.local/bin and the package is never found.
# macOS ships no `readlink -f`, hence the loop.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link_dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;                    # already absolute
    *) src="$link_dir/$src" ;;  # relative to the link's directory
  esac
done
here="$(cd -P "$(dirname "$src")/.." && pwd)"
python_bin="${STORAGESCAN_PYTHON:-python3}"

# On a Mac without the Apple Command Line Tools, /usr/bin/python3 is a stub
# that pops a GUI installer and exits non-zero. Catch that here rather than
# letting it surface later as an unreadable error.
if ! "$python_bin" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' \
        >/dev/null 2>&1; then
  cat <<'MESSAGE'
macosscanner needs Python 3.9 or newer, which macOS ships with the Apple
Command Line Tools. Install them with:

    xcode-select --install

then run macosscanner again.

If you have Python somewhere else, point at it directly:

    STORAGESCAN_PYTHON=/opt/homebrew/bin/python3 macosscanner
MESSAGE
  exit 3
fi

export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_bin" -m storagescan "$@"
